<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!-- Indépendant du feature flag local (.env) : les tests doivent toujours couvrir le
             comportement par défaut, sécurisé, de production — pas le réglage temporaire de
             désactivation utilisé en dev pour accélérer les tests fonctionnels manuels. -->
        <env name="FORCE_PASSWORD_CHANGE" value="true"/>
        
        <!-- MySQL, comme en dev et en CI (voir .github/workflows/ci.yml) : le SQLite en
             mémoire précédemment utilisé ici n'impose pas les mêmes contraintes ENUM que
             MySQL, ce qui a déjà laissé passer plusieurs bugs invisibles en local (voir par
             exemple les correctifs sur registrations.status, teachers.rib, parent_user.
             lien_parente) et détectés seulement en production. Base dédiée (edu_manager_test),
             distincte de la base de développement : RefreshDatabase la vide à chaque run. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="edu_manager_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
